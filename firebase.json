{
  "hosting": {
    "site": "mighty-link-ai-connect-13d22",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "venv/**",
      "tests/**",
      ".git/**",
      ".github/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "api", "region": "us-central1" }
      },
      {
        "source": "/admin/**",
        "run": { "serviceId": "api", "region": "us-central1" }
      },
      {
        "source": "/exports/**",
        "run": { "serviceId": "api", "region": "us-central1" }
      }
    ]
  },
  "functions": [
    {
      "source": ".",
      "runtime": "python312"
    }
  ]
}
